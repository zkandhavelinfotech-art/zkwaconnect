    { "src": "/icons/zkwaconnect-icon-48.png",  "sizes": "48x48",   "type": "image/png" },
    { "src": "/icons/zkwaconnect-icon-72.png",  "sizes": "72x72",   "type": "image/png" },
    { "src": "/icons/zkwaconnect-icon-96.png",  "sizes": "96x96",   "type": "image/png" },
    { "src": "/icons/zkwaconnect-icon-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "/icons/zkwaconnect-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/zkwaconnect-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
