{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "commonjs",
    "lib":               ["ES2020"],
    "outDir":            "./dist",
    "rootDir":           "./src",
    "strict":            false,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "resolveJsonModule": true,
    "declaration":       true,
    "baseUrl":           ".",
    "paths": {
      "@zkwa/types": ["../../packages/types/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules","dist","src/__tests__"]
}
