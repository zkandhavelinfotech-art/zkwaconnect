generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AdminRole {
  NONE
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
  OPERATIONS
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum OnboardingStep {
  NOT_STARTED
  ACCOUNT_CREATED
  META_PENDING
  META_CONNECTED
  WABA_PENDING
  WABA_CREATED
  PHONE_PENDING
  PHONE_VERIFICATION_PENDING
  PHONE_VERIFIED
  ACTIVATION_PENDING
  COMPLETED
}

enum SubscriptionStatus {
  // Plan chosen and invoiced; becomes ACTIVE once the payment is approved
  PENDING_PAYMENT
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  UPI
  QR
  RAZORPAY
  CASHFREE
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?
  passwordHash    String?
  name            String
  status          UserStatus @default(ACTIVE)
  adminRole       AdminRole  @default(NONE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships           Membership[]
  sessions              Session[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  sentMessages          Message[]
  assignedConversations Conversation[]
  pushSubscriptions     PushSubscription[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  legalName String?
  email     String?
  phone     String?
  country   String             @default("IN")
  timezone  String             @default("Asia/Kolkata")
  currency  String             @default("INR")
  gstin     String?
  state     String?
  billingAddress    String?
  billingCity       String?
  billingPostalCode String?
  billingStateCode  String?
  walletBalance     Decimal            @default(0) @db.Decimal(14, 4)
  // DIRECT | PLATFORM_FEE | RESELLER — null means the platform default (set by super admin)
  messagingBillingMode String?
  lowBalanceAlertAt DateTime?
  status    OrganizationStatus @default(TRIAL)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships     Membership[]
  oauthStates     OAuthState[]
  metaConnections MetaConnection[]
  wabas           Waba[]
  onboarding      Onboarding?
  subscriptions   Subscription[]
  payments        Payment[]
  invoices        Invoice[]
  contacts        Contact[]
  conversations   Conversation[]
  campaigns       Campaign[]
  templates       Template[]
  workflows       Workflow[]
  forms           HostedForm[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  supportTickets  SupportTicket[]
  webhookEvents   WebhookEvent[]
  quickReplies    QuickReply[]
  inboxSettings   InboxSettings?
  apiKeys         ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  adReferrals     AdReferral[]
  segments        Segment[]
  walletTransactions WalletTransaction[]
  orders          Order[]
  integrations    Integration[]
  trackedLinks    TrackedLink[]
  invitations     Invitation[]
  instagramAccounts InstagramAccount[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole   @default(AGENT)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model OAuthState {
  id             String       @id @default(cuid())
  organizationId String
  stateHash      String       @unique
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@map("oauth_states")
}

model MetaConnection {
  id                   String           @id @default(cuid())
  organizationId       String
  metaUserId           String?
  businessManagerId    String?
  accessTokenEncrypted String?
  tokenExpiresAt       DateTime?
  status               ConnectionStatus @default(PENDING)
  connectedAt          DateTime?
  lastSyncedAt         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("meta_connections")
}

model Waba {
  id                 String           @id @default(cuid())
  organizationId     String
  metaBusinessId     String?
  wabaId             String           @unique
  name               String
  status             ConnectionStatus @default(PENDING)
  currency           String?
  timezone           String?
  qualityRating      String?
  messagingTier      String?
  verificationStatus String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumbers       PhoneNumber[]
  templates          Template[]
  forms              HostedForm[]

  @@index([organizationId])
  @@map("wabas")
}

model PhoneNumber {
  id                 String           @id @default(cuid())
  wabaId             String
  phoneNumberId      String           @unique
  displayName        String?
  phoneNumber        String
  countryCode        String?
  status             ConnectionStatus @default(PENDING)
  verificationStatus String?
  qualityRating      String?
  messagingLimit     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  waba               Waba             @relation(fields: [wabaId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  campaigns          Campaign[]

  @@index([wabaId])
  @@map("phone_numbers")
}

model Onboarding {
  id              String         @id @default(cuid())
  organizationId  String         @unique
  currentStep     OnboardingStep @default(NOT_STARTED)
  status          OnboardingStep @default(NOT_STARTED)
  metaConnected   Boolean        @default(false)
  wabaCreated     Boolean        @default(false)
  phoneRegistered Boolean        @default(false)
  phoneVerified   Boolean        @default(false)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboardings")
}

model Plan {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  monthlyPrice    Decimal        @db.Decimal(12, 2)
  annualPrice     Decimal?       @db.Decimal(12, 2)
  maxUsers        Int?
  maxPhoneNumbers Int?
  maxMessages     Int?
  features        Json?
  status          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  billingInterval    String             @default("MONTHLY")
  startDate          DateTime           @default(now())
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])
  payments           Payment[]
  invoices           Invoice[]

  @@index([organizationId])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  invoiceNumber  String        @unique
  // SUBSCRIPTION | WALLET_TOPUP
  kind           String        @default("SUBSCRIPTION")
  description    String?
  amount         Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         String        @default("DUE")
  gstin          String?
  hsnCode        String?
  sellerName     String?
  sellerGstin    String?
  buyerName      String?
  buyerAddress   String?
  placeOfSupply  String?
  gstRate        Decimal       @default(18) @db.Decimal(5, 2)
  cgst           Decimal       @default(0) @db.Decimal(12, 2)
  sgst           Decimal       @default(0) @db.Decimal(12, 2)
  igst           Decimal       @default(0) @db.Decimal(12, 2)
  pdfUrl         String?
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  payments       Payment[]

  @@map("invoices")
}

model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  contactId       String?
  subscriptionId  String?
  invoiceId       String?
  amount          Decimal       @db.Decimal(12, 2)
  description     String?
  currency        String        @default("INR")
  method          PaymentMethod @default(UPI)
  upiId           String?
  transactionId   String?
  proofUrl        String?
  paymentLinkUrl  String?
  status          PaymentStatus @default(PENDING)
  submittedAt     DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, status])
  @@map("payments")
}

model WebhookEvent {
  id              String        @id @default(cuid())
  organizationId  String?
  wabaId          String?
  eventType       String
  externalEventId String?
  payload         Json
  status          String        @default("RECEIVED")
  error           String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([wabaId, createdAt])
  @@map("webhook_events")
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String
  phone          String
  name           String?
  email          String?
  source         String?
  tags           Json?
  metadata       Json?
  optedIn        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  formSubmissions FormSubmission[]
  payments        Payment[]
  campaignRecipients CampaignRecipient[]
  adReferrals     AdReferral[]
  orders          Order[]
  // Instagram-scoped user id for contacts who message on Instagram (their phone is stored as "ig:<id>")
  instagramId     String?
  optedOutAt      DateTime?

  @@unique([organizationId, phone])
  @@index([organizationId, instagramId])
  @@map("contacts")
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  // WHATSAPP (phoneNumberId set) | INSTAGRAM (instagramAccountId set)
  channel        String       @default("WHATSAPP")
  phoneNumberId  String?
  instagramAccountId String?
  contactId      String
  status         String       @default("OPEN")
  assignedUserId String?
  lastMessageAt  DateTime?
  unreadCount    Int          @default(0)
  flowState      Json?
  awayMessageAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber    PhoneNumber? @relation(fields: [phoneNumberId], references: [id])
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  contact        Contact      @relation(fields: [contactId], references: [id])
  messages       Message[]
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("conversations")
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  externalMessageId String?
  senderUserId      String?
  direction         String
  type              String
  content           String?
  status            String?
  mediaUrl          String?
  metadata          Json?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser        User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([externalMessageId])
  @@map("messages")
}

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  phoneNumberId  String
  name           String
  status         String       @default("DRAFT")
  audienceType   String       @default("ALL")
  audienceLabels Json?
  segmentId      String?
  templateParameters Json?
  // Per-variable source: { "1": { source: "name"|"phone"|"email"|"attribute"|"text", value?, fallback? } }
  variableMapping Json?
  templateId     String?
  scheduledAt    DateTime?
  pausedReason   String?
  startedAt      DateTime?
  completedAt    DateTime?
  totalCount     Int          @default(0)
  sentCount      Int          @default(0)
  deliveredCount Int          @default(0)
  readCount      Int          @default(0)
  failedCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber    PhoneNumber  @relation(fields: [phoneNumberId], references: [id])
  template       Template?    @relation(fields: [templateId], references: [id])
  recipients     CampaignRecipient[]

  @@index([organizationId, status])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

// One row per contact in a broadcast: the send queue and the delivery report.
// status: QUEUED → SENDING → SENT → DELIVERED → READ, or FAILED / SKIPPED
model CampaignRecipient {
  id                String    @id @default(cuid())
  campaignId        String
  organizationId    String
  contactId         String?
  phone             String
  name              String?
  variables         Json?
  status            String    @default("QUEUED")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lockedAt          DateTime?
  externalMessageId String?
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  repliedAt         DateTime?
  clickedAt         DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([status, nextAttemptAt])
  @@index([externalMessageId])
  @@index([contactId, sentAt])
  @@map("campaign_recipients")
}

model Template {
  id              String       @id @default(cuid())
  organizationId  String
  wabaId          String
  metaTemplateId  String?
  name            String
  language        String
  category        String
  status          String       @default("PENDING")
  content         String?
  components      Json?
  // Header/card media kept on our server so media and carousel templates can be sent (Meta needs the file at send time).
  mediaAssets     Json?
  // URL buttons with click tracking: [{ index, destination }] (button URL is APP_URL/l/{{1}})
  trackedButtons  Json?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waba            Waba         @relation(fields: [wabaId], references: [id])
  campaigns       Campaign[]

  @@unique([organizationId, name, language])
  @@map("templates")
}

model Workflow {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  triggerType     String       @default("KEYWORD")
  triggerValue    String
  replyText       String       @default("")
  flow            Json?
  handoffToHuman  Boolean      @default(false)
  status          String       @default("PAUSED")
  priority        Int          @default(100)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, priority])
  @@map("workflows")
}

model HostedForm {
  id             String          @id @default(cuid())
  organizationId String
  wabaId         String?
  slug           String
  name           String
  title          String
  description    String?
  fields         Json
  status         String          @default("DRAFT")
  metaFlowId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waba           Waba?           @relation(fields: [wabaId], references: [id], onDelete: SetNull)
  submissions    FormSubmission[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("hosted_forms")
}

model FormSubmission {
  id              String     @id @default(cuid())
  formId          String
  contactId       String?
  values          Json
  whatsappConsent Boolean    @default(false)
  submittedAt     DateTime   @default(now())
  form            HostedForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact         Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([formId, submittedAt])
  @@map("form_submissions")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  title          String
  message        String
  readAt         DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, readAt])
  @@map("notifications")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  actorType      String
  action         String
  resource       String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model SupportTicket {
  id             String       @id @default(cuid())
  organizationId String
  createdBy      String?
  subject        String
  description    String
  priority       String       @default("NORMAL")
  status         String       @default("OPEN")
  assignedTo     String?
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

// Saved replies agents insert in the inbox by typing "/" + shortcut.
model QuickReply {
  id             String       @id @default(cuid())
  organizationId String
  shortcut       String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@map("quick_replies")
}

// Auto-assignment, business hours and away message for a workspace's inbox.
model InboxSettings {
  organizationId       String       @id
  autoAssign           String       @default("OFF") // OFF | ROUND_ROBIN | LEAST_BUSY
  agentIds             Json?
  lastAssignedUserId   String?
  businessHoursEnabled Boolean      @default(false)
  timezone             String       @default("Asia/Kolkata")
  hours                Json?        // { mon: [{ open: "09:00", close: "18:00" }], ... }
  awayMessage          String?
  awayCooldownMinutes  Int          @default(240)
  optOutEnabled        Boolean      @default(true)
  optOutKeywords       Json?
  optOutMessage        String?
  optInKeywords        Json?
  optInMessage         String?
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("inbox_settings")
}

// Developer API keys (only a SHA-256 hash is stored).
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  keyHash        String       @unique
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// Customer endpoints that receive events (signed with HMAC-SHA256).
model WebhookEndpoint {
  id             String            @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         Json
  description    String?
  active         Boolean           @default(true)
  failureCount   Int               @default(0)
  lastDeliveryAt DateTime?
  lastStatus     Int?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

// Outgoing webhook queue with retries. status: PENDING → SENDING → DELIVERED | FAILED
model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  organizationId String
  event          String
  payload        Json
  status         String          @default("PENDING")
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  lockedAt       DateTime?
  responseStatus Int?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// A conversation started from a Click-to-WhatsApp ad or Facebook/Instagram post.
model AdReferral {
  id             String       @id @default(cuid())
  organizationId String
  contactId      String
  conversationId String?
  messageId      String?
  sourceType     String
  sourceId       String?
  sourceUrl      String?
  headline       String?
  body           String?
  mediaType      String?
  ctwaClid       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, sourceId])
  @@index([conversationId])
  @@map("ad_referrals")
}

// A saved contact filter, usable as a broadcast audience.
model Segment {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  filters        Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("segments")
}

// Platform-wide settings edited by super admins (e.g. "messaging_billing").
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// Message wallet ledger. amount is signed (+ credit, - debit); balanceAfter is the wallet balance after it.
model WalletTransaction {
  id             String       @id @default(cuid())
  organizationId String
  type           String       // TOPUP | DEBIT | REFUND | ADJUSTMENT
  amount         Decimal      @db.Decimal(14, 4)
  balanceAfter   Decimal      @db.Decimal(14, 4)
  reason         String
  category       String?
  mode           String?
  metaCost       Decimal?     @db.Decimal(14, 4)
  conversationId String?
  campaignId     String?
  invoiceId      String?
  refundOf       String?      @unique
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("wallet_transactions")
}

// Orders from WhatsApp carts, Shopify and WooCommerce (and abandoned checkouts, status CHECKOUT).
model Order {
  id             String       @id @default(cuid())
  organizationId String
  contactId      String?
  conversationId String?
  integrationId  String?
  source         String       // WHATSAPP | SHOPIFY | WOOCOMMERCE
  externalId     String
  orderNumber    String?
  status         String       @default("NEW") // CHECKOUT | NEW | CONFIRMED | PAID | SHIPPED | DELIVERED | CANCELLED | RECOVERED
  paymentMethod  String?
  codStatus      String?      // PENDING | CONFIRMED | CANCELLED
  currency       String       @default("INR")
  total          Decimal      @default(0) @db.Decimal(14, 2)
  items          Json
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  checkoutUrl    String?
  trackingNumber String?
  trackingUrl    String?
  notified       Json?
  remindAt       DateTime?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([organizationId, source, externalId])
  @@index([organizationId, createdAt])
  @@index([status, remindAt])
  @@map("orders")
}

// Store connections (Shopify, WooCommerce) and inbound automation hooks (Zapier, Pabbly, Make, Google Sheets).
model Integration {
  id              String       @id @default(cuid())
  organizationId  String
  type            String       // SHOPIFY | WOOCOMMERCE | INBOUND_HOOK
  name            String
  status          String       @default("ACTIVE")
  config          Json
  secretEncrypted String?
  token           String?      @unique
  lastEventAt     DateTime?
  lastError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("integrations")
}

// An Instagram professional account (via its Facebook Page) connected for the inbox.
model InstagramAccount {
  id                 String         @id @default(cuid())
  organizationId     String
  pageId             String         @unique
  pageName           String
  igUserId           String         @unique
  username           String
  pictureUrl         String?
  pageTokenEncrypted String
  status             String         @default("CONNECTED")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations      Conversation[]

  @@map("instagram_accounts")
}

// Web push subscriptions for the installable app (new-message alerts).
model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Short tracked link (/l/<code>) that records clicks and redirects to the destination.
model TrackedLink {
  id             String       @id @default(cuid())
  code           String       @unique
  organizationId String
  destination    String
  templateId     String?
  campaignId     String?
  recipientId    String?
  contactId      String?
  conversationId String?
  clicks         Int          @default(0)
  firstClickedAt DateTime?
  lastClickedAt  DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([campaignId])
  @@map("tracked_links")
}

// Team invitation: a one-time link (only its hash is stored) to join a workspace with a role.
model Invitation {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole @default(AGENT)
  tokenHash      String         @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}
