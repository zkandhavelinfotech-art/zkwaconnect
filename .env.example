# ZKWAConnect v4.0.7 — copy to .env and fill all values (Admin → 🚀 Go-live checklist shows what's missing)

# Database (Railway PostgreSQL — required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Auth (generate random 32+ char strings)
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=replace-with-32-char-random-string-here

# App URL
APP_URL=https://app.zkwaconnect.in
NEXT_PUBLIC_APP_URL=https://app.zkwaconnect.in
SUPPORT_WHATSAPP_NUMBER=91XXXXXXXXXX

# Meta WhatsApp Business API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-webhook-verify-token
META_GRAPH_API_VERSION=v25.0
META_OAUTH_REDIRECT_URI=https://app.zkwaconnect.in/api/meta/oauth/callback
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_CONFIG_ID=your-meta-config-id

# UPI Payment
UPI_ID=zkwaconnect@upi
COMPANY_NAME=ZKandhavel Infotech Pvt. Ltd.
GSTIN=33AABCZ1234A1Z5
COMPANY_ADDRESS=Your registered business address
HSN_CODE=998314
GST_RATE=18

# Customer payment links (optional; UPI works without a gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# Company details on the legal pages (/privacy, /terms, /refund-policy, /data-deletion) — COMPANY_NAME, GSTIN and COMPANY_ADDRESS above are used too
SUPPORT_EMAIL=support@zkwaconnect.in
GRIEVANCE_OFFICER=
LEGAL_JURISDICTION=Chennai, Tamil Nadu

# Email (SMTP) for password reset and test emails — Google Workspace, Zoho Mail, Amazon SES, Brevo, Hostinger…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZKWAConnect <no-reply@zkwaconnect.in>"

# Media storage. Best: an S3-compatible bucket (Cloudflare R2 shown). Otherwise STORAGE_DIR on a persistent disk (e.g. Railway volume at /data).
S3_ENDPOINT=
# e.g. https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_DIR=

# Background jobs: leave CAMPAIGN_WORKER unset on always-on servers (Railway). For Vercel/cron set CAMPAIGN_WORKER=off and CRON_SECRET.
CAMPAIGN_WORKER=
CRON_SECRET=

# First deploy only: super admin created by `npm run db:seed` (a random password is printed if SEED_ADMIN_PASSWORD is empty)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Demo account + "Fill demo credentials" box on the login page — keep off on the live site
SEED_DEMO=off
NEXT_PUBLIC_DEMO_LOGIN=off
