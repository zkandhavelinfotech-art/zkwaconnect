# ZKWAConnect v4.0.6 — copy to .env and fill all values

# Database (Railway PostgreSQL — required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Auth (generate random 32+ char strings)
SESSION_SECRET=replace-with-32-char-random-string-here
ENCRYPTION_KEY=replace-with-32-char-random-string-here

# App URL
APP_URL=https://app.zkwaconnect.in
NEXT_PUBLIC_APP_URL=https://app.zkwaconnect.in
SUPPORT_WHATSAPP_NUMBER=91XXXXXXXXXX

# Meta WhatsApp Business API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-webhook-verify-token
META_GRAPH_API_VERSION=v25.0
# Optional: agency Business Portfolio ID to verify and guide partner assignment per workspace
META_AGENCY_BUSINESS_ID=your-agency-business-id
# Optional: exact business-scoped system user to receive WABA tasks when multiple users exist.
META_SYSTEM_USER_ID=your-business-scoped-system-user-id
META_OAUTH_REDIRECT_URI=https://app.zkwaconnect.in/api/meta/oauth/callback
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_CONFIG_ID=your-meta-config-id

# UPI Payment
UPI_ID=zkwaconnect@upi
COMPANY_NAME=ZKandhavel Infotech Pvt. Ltd.
GSTIN=33AABCZ1234A1Z5
COMPANY_ADDRESS=Your registered business address
HSN_CODE=998314
GST_RATE=18

# Customer payment links (optional; UPI works without a gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
# Canonical internal SaaS product-owner account. Never reuse a client login here.
SEED_ADMIN_EMAIL="zkanddhavelinfotech@gmail.com"
SEED_ADMIN_PASSWORD="replace-with-a-long-unique-password"
PRIMARY_ADMIN_EMAIL="zkanddhavelinfotech@gmail.com"
